[Unit]
Description=CasaNova Driver Service
After=casanova-gateway.service
After=casanova-message-bus.service
Wants=casanova-gateway.service
Wants=casanova-message-bus.service
PartOf=casanova-gateway.service
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=notify
ExecStartPre=/usr/bin/casanova-driver -v
ExecStart=/usr/bin/casanova-driver -c /etc/casanova/driver.conf
Restart=always
RestartSec=5

# REQUIRED shared-runtime fix: without RuntimeDirectoryPreserve=yes, restarting
# any one service wipes the shared /run/casaos (management.url / static.url /
# message-bus.url live there) and crash-loops the whole CasaNova stack.
RuntimeDirectory=casanova casaos
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

NoNewPrivileges=yes
# The service reads /sys and /proc and shells out to modprobe/rmmod and the GPU
# driver selector, which manipulate kernel modules — keep ProtectSystem=full
# (not strict) and grant the runtime/log/state paths it writes.
ProtectSystem=full
ProtectHome=no
PrivateTmp=yes
ProtectControlGroups=yes
# /opt/casanova is prefixed with "-" (ignore-if-absent). ReadWritePaths= is a
# HARD PRECONDITION -- systemd builds the mount namespace before exec, so a
# directory that does not exist fails the start with 226/NAMESPACE and the
# binary never runs. Nothing in this tree creates /opt/casanova: it is the
# DriverDataRoot (/opt/casanova/drivers), populated by the out-of-tree driver
# package manager, and on a box where no driver was ever installed it simply
# does not exist. So the unit demanded a directory that only a separate,
# optional component ever makes -- and stayed dead until it did.
# This service moreover only READS that root: ListInstalled() walks
# modules.d/, disabled.d/ and meta/, and collectConfNames/collectMetaNames
# swallow the ReadDir error, so an absent root correctly yields an empty driver
# list. Its own state is /var/lib/casanova/host-tuning.json, which is listed
# above and stays mandatory.
# Nothing is given up by ignoring it: under ProtectSystem=full only /usr, /boot,
# /efi and /etc are mounted read-only, so /opt is writable either way and this
# entry granted no confinement -- its only effect was the existence check.
ReadWritePaths=/var/lib/casanova /var/lib/casaos /var/log/casanova /var/log/casaos /var/run/casanova /var/run/casaos -/opt/casanova

[Install]
WantedBy=multi-user.target
