[Unit]
Description=CasaNova Main Service
# Wave 35-P: casanova/main.go calls Gateway().CreateRoute() at startup —
# the previous unit listed every helper After= but NOT the gateway, so
# on parallel boot casanova would race the gateway and panic with
# connection-refused on a fast disk.
After=casanova-gateway.service
After=casanova-message-bus.service
After=casanova-user-service.service
After=casanova-local-storage.service
After=casanova-app-management.service
After=casanova-job-management.service
After=rclone.service
# Wave 35-P: this unit is the user-facing entry point. Wants= ensures
# `systemctl enable casanova.service` brings the entire stack up — the
# old units only had After= and silently dropped helpers that the user
# never enabled by hand.
Wants=casanova-gateway.service
Wants=casanova-message-bus.service
Wants=casanova-user-service.service
Wants=casanova-local-storage.service
Wants=casanova-app-management.service
Wants=casanova-job-management.service
PartOf=casanova-gateway.service
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=notify
ExecStart=/usr/bin/casanova -c /etc/casanova/casanova.conf
Restart=always
RestartSec=5
# DECLARED, not inherited. Boot-time storage recovery is bounded in-process by
# storageMaintenanceStartBudget (main.go); that bound is only meaningful if
# systemd waits longer than it. Leaving this unset inherits
# DefaultTimeoutStartSec, which a distribution is free to lower in system.conf
# — on such a host the in-process deadline could never fire and a stuck mount
# would turn into a restart loop instead of a bounded delay.
# TestStartupBudgetFitsInsideTheSystemdStartTimeout reads this value.
TimeoutStartSec=120
RuntimeDirectory=casanova casaos
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=no
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/casanova /var/lib/casaos /var/log/casanova /var/log/casaos /var/run/casanova /var/run/casaos /DATA /mnt /media /etc/casanova /etc/casaos

[Install]
WantedBy=multi-user.target
