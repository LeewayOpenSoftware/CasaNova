[Unit]
Description=CasaNova App Management Service
After=casanova-gateway.service
After=casanova-message-bus.service
After=casanova-local-storage.service
After=docker.service
# Wave 35-P: Wants= is what actually pulls a unit in. Without it the
# downstream stack does not auto-start when the gateway is restarted,
# and `systemctl enable casanova.service` does not enable the helpers.
Wants=casanova-gateway.service
Wants=casanova-message-bus.service
Wants=casanova-local-storage.service
# Wave 35-P: Docker is a hard dependency — without it every docker API
# call fails and the service flaps forever. Requires= cascades restarts;
# if Docker dies, app-management goes with it instead of looping.
Requires=docker.service
PartOf=casanova-gateway.service
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=notify
ExecStartPre=/usr/bin/casanova-app-management -v
ExecStart=/usr/bin/casanova-app-management -c /etc/casanova/app-management.conf
Restart=always
RestartSec=5
RuntimeDirectory=casanova casaos
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
# app-management talks to /var/run/docker.sock and writes compose files
# under /var/lib/casanova/apps + /DATA, so ProtectSystem=full not strict.
ProtectSystem=full
ProtectHome=no
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
# docker.sock is prefixed with "-" (ignore-if-absent) following the t-039
# convention: ReadWritePaths= is a hard precondition in systemd, so an un-prefixed
# socket path that does not exist at service start fails with 226/NAMESPACE.
ReadWritePaths=/var/lib/casanova /var/lib/casaos /var/log/casanova /var/log/casaos /var/run/casanova /var/run/casaos -/var/run/docker.sock -/run/docker.sock /DATA /mnt
# Wave 35-P: docker pull pulls arbitrary images chosen by users — cap
# resident memory so a runaway pull cannot OOM-kill the host. 1G is
# generous for the parent process; the child docker daemon owns its own.
MemoryMax=1G

[Install]
WantedBy=multi-user.target
