[Unit]
Description=CasaNova Gateway
After=network.target
Wants=network-online.target
After=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=notify
ExecStartPre=/usr/bin/casanova-gateway -v
ExecStart=/usr/bin/casanova-gateway -w /var/lib/casanova/www
Restart=always
RestartSec=5
# Wave 35-P: Type=notify provides MainPID via sd_notify; PIDFile= referenced
# /var/run/casanova/gateway.pid which the binary never wrote (RuntimePath in
# the embedded sample config still points at /var/run/casaos), so systemd
# was constantly logging "Can't open PID file ... No such file or directory"
# and refusing to track restarts. Drop it — sd_notify is enough.
#
# Wave 35-P: /run is tmpfs and disappears on every reboot. RuntimeDirectory=
# tells systemd to recreate the directory at startup with the right perms.
# Both names are listed because the Go services still hardcode the legacy
# /var/run/casaos path until CasaNova-Common's DefaultConfigPath rename.
RuntimeDirectory=casanova casaos
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
# Hardening — defense in depth. ReadWritePaths covers the legacy + new
# state directories so tightening ProtectSystem=strict does not break
# existing /var/lib/casaos writes.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/casanova /var/lib/casaos /var/log/casanova /var/log/casaos /var/run/casanova /var/run/casaos /etc/casanova /etc/casaos

[Install]
WantedBy=multi-user.target
