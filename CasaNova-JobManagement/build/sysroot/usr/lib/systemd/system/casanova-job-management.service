[Unit]
Description=CasaNova Job Management Service
After=casanova-gateway.service
After=casanova-message-bus.service
After=casanova-app-management.service
After=docker.service
Wants=casanova-gateway.service
Wants=casanova-message-bus.service
PartOf=casanova-gateway.service
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=notify
# Wave 35-P: previous ExecStart had no -c flag, so the binary fell back
# to its embedded sample (effectively empty) and silently ignored every
# edit the operator made to /etc/casanova/job-management.conf.
ExecStartPre=/usr/bin/casanova-job-management -v
ExecStart=/usr/bin/casanova-job-management -c /etc/casanova/job-management.conf
Restart=always
RestartSec=5
RuntimeDirectory=casanova casaos
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
# job-management shells out to docker exec, so it needs the docker socket
# and may write logs into the container's mounts.
ProtectSystem=full
ProtectHome=no
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
# docker.sock is prefixed with "-" (ignore-if-absent) following the t-039
# convention: ReadWritePaths= is a hard precondition in systemd, so an un-prefixed
# socket path that does not exist at service start fails with 226/NAMESPACE.
ReadWritePaths=/var/lib/casanova /var/lib/casaos /var/log/casanova /var/log/casaos /var/run/casanova /var/run/casaos -/var/run/docker.sock -/run/docker.sock /DATA

[Install]
WantedBy=multi-user.target
