[Unit]
Description=CasaNova Message Bus Service
After=casanova-gateway.service
# Wave 35-P: After= is pure ordering. Without Wants=/PartOf= the service
# never auto-starts when the gateway is restarted, and downstream proxy
# routes silently 502 until the operator restarts each downstream by hand.
Wants=casanova-gateway.service
PartOf=casanova-gateway.service
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=notify
ExecStartPre=/usr/bin/casanova-message-bus -v
ExecStart=/usr/bin/casanova-message-bus -c /etc/casanova/message-bus.conf
Restart=always
RestartSec=5
RuntimeDirectory=casanova casaos
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/casanova /var/lib/casaos /var/log/casanova /var/log/casaos /var/run/casanova /var/run/casaos

[Install]
WantedBy=multi-user.target
