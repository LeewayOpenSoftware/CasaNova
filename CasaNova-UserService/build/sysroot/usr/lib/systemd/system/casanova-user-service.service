[Unit]
Description=CasaNova User Service
After=casanova-gateway.service
After=casanova-message-bus.service
Wants=casanova-gateway.service
Wants=casanova-message-bus.service
PartOf=casanova-gateway.service
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=notify
ExecStartPre=/usr/bin/casanova-user-service -v
ExecStart=/usr/bin/casanova-user-service -c /etc/casanova/user-service.conf
Restart=always
RestartSec=5
RuntimeDirectory=casanova casaos
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/casanova /var/lib/casaos /var/log/casanova /var/log/casaos /var/run/casanova /var/run/casaos

[Install]
WantedBy=multi-user.target
